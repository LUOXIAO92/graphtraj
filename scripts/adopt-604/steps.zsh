  After the member's completed notice, before retiring the member, Main's Bash: zsh $THIS Nr
EOF2
  next "zsh $THIS Nr" ;;

Nr) print "[Nr] Main. Read only: the child $CHILD's and the member's records, one notice, the member's subagents calls (593's nr_read with $DONEWORD, rec593.py, notices499.py). No login. Dialog: none."
  { nr_read; nrc=$?
    ck $nrc "Nr 593's record checks ran (their CHECK lines above)"
  } 2>&1 | tee $R/Nr.txt
  MEMBER=$(sed -n 's/^MEMBER //p' $R/Nr.txt | tail -1)
  { if [[ -s $R/N-main-notice.txt ]]; then nc=$(clean $CONDA -I $S593/notices499.py $R/N-main-notice.txt "$MEMBER"); [[ $nc == 1 ]]; ck $? "Nr Main got exactly one completed notice of the member" "$nc"
    else print "CHECK 604 Nr Main got exactly one completed notice of the member: PENDING (save it to $R/N-main-notice.txt)"; fi
    SID=$(sed -n 's/^SESSION //p' $R/Nr.txt | tail -1); bare=${SID#*:}
    if [[ -n $MEMBER && -n $bare ]]; then   # the member's records by its Session id (593's rs_session_files): archive header, Claude transcript
      mf=(); for f in $SESS/*/session.jsonl(N); do head -1 $f | grep -qF -- $bare && mf+=$f; done; mf+=(${PROJECTS:h}/*/$bare.jsonl(N))
      print -r -- "member $MEMBER (Session $SID) record files: ${#mf}"
      clean $CONDA -I $S593/rec593.py calls "member $MEMBER" --need subagents $mf; ck $? "Nr member called mcp__graphtraj__subagents without error (rec593.py above)"
    else ck 1 "Nr member alias and Session found" "member ${MEMBER:-none}, session ${SID:-none}"; fi
    sa=$([[ -r $R/N.txt ]] && grep -oE '"agent" *: *"[^"]+"' $R/N.txt | head -1 | sed -E 's/.*: *"([^"]+)"/\1/')
    [[ -n $sa ]]; ck $? "Nr swarm result has agent" "${sa:-none}"
    [[ -n $sa ]] && print -r -- "SWARM_AGENT $sa"
  } 2>&1 | tee -a $R/Nr.txt
  grep -qE '^CHECK .*: (FAIL|PENDING|NOT OBSERVED|CHECK BY HAND)' $R/Nr.txt && { print "\nNr not passed (see above). PENDING: save the files and rerun Nr. FAIL: hand $R/Nr.txt to the Team."; exit 1; }
  sa=$(sed -n 's/^SWARM_AGENT //p' $R/Nr.txt | tail -1)
  [[ -n $sa ]] && print "\nRetire the member (Main pastes): Using only mcp__graphtraj__subagents: retire with arguments {\"agent\":\"$sa\"} given inline (no arguments_file) and print the raw result."
  print "Success: every CHECK line PASS (child completed with $DONEWORD, created without tools, one execution, notice delivered; member's subagents calls; one notice; swarm agent)."
  next "zsh $THIS C601" ;;

C601) print "[C601] Main. Read only: records Task 601's pre-state to $R/C601-pre.txt and prints ONE prompt for Main's public cleanup call. This step never calls cleanup. No login. Dialog: none."
  { D=$(t601); st=$(yml $D/task.yml status) disp=$(disposition_of $D) w601=$(yml $D/task.yml worktree) b601=$(yml $D/task.yml branch)
    [[ -f $D/task.yml ]] || { print -r -- "STOP: $D/task.yml not readable"; exit 1; }
    print -r -- "PRE status $st"; print -r -- "PRE disposition ${disp:-unreadable}"
    print -r -- "PRE worktree $H/$w601"; print -r -- "PRE branch $b601"
    tip=$(gg -C $REPO rev-parse -q --verify refs/heads/$b601); print -r -- "PRE tip ${tip:-none}"
    dev=$(gg -C $REPO rev-parse -q --verify refs/heads/dev); print -r -- "PRE dev ${dev:-none}"
    for f in ${(f)"$(cd $D && find task.yml definitions execution-budget.yml teams -type f 2>/dev/null | sort)"}; do print -r -- "PRE file $f"; done
    [[ $disp == cancelled && $st != integrated ]]; ck $? "C601 601 is cancelled and never integrated" "status $st, disposition ${disp:-unreadable}"
    reg=$(gg -C $REPO worktree list --porcelain | awk -v w="worktree $H/$w601" '$0==w{f=1; next} /^worktree /{f=0} f && /^branch /{print substr($0,8)}')
    [[ -d $H/$w601 && $reg == refs/heads/$b601 && -n $tip ]]; ck $? "C601 601's Worktree exists, registered on refs/heads/$b601 (tip ${tip[1,8]})" "${reg:-not registered}"
    s601=$(gg -C $H/$w601 status --porcelain --untracked-files=all 2>&1); src=$?
    (( src == 0 )) && [[ -z $s601 ]]; ck $? "C601 601's Worktree is clean" "${${s601//$'\n'/ }[1,200]}"
    [[ $dev == $DEVWANT ]]; ck $? "C601 dev is ${DEVWANT[1,8]}"
    listing=$(ps -axww -o pid=,command= 2>&1) || { ck 1 "C601 ps lists processes" "${listing[1,120]}"; listing=""; }
    w=$(print -r -- $listing | grep -E -- '-m graphtraj\.execution\.runner_worker' | grep -F -- "/601-")
    [[ -n $listing && -z $w ]]; ck $? "C601 no member Worker for 601 runs" "${w[1,200]}"
  } 2>&1 | tee $R/C601-pre.txt; rc=${pipestatus[1]}
  (( rc == 0 )) && ! grep -q ': FAIL' $R/C601-pre.txt || { print "\nC601 STOP (see above). Do not call cleanup. Hand $R/C601-pre.txt to the Team."; exit 1; }
  rm -f $R/C601.txt
  cat <<EOF2 | tee $R/C601-prompt.txt

[C601] Paste in the Claude Main (ONE public cleanup call; arguments INLINE, never arguments_file):
Using only mcp__graphtraj__tasks: execute cleanup with arguments {"task_id":"601"} given inline in the "arguments" field (no arguments_file). Print the raw result exactly and whether it was an error. Then, with Bash, save that raw result exactly as $R/C601.txt.
  Success: cleanup_status "cleaned", evidence task_disposition "cancelled", task_commit $(sed -n 's/^PRE tip //p' $R/C601-pre.txt).
EOF2
  next "zsh $THIS C601r    (after Main saved $R/C601.txt)" ;;

C601r) print "[C601r] Main. Read only: Main's raw cleanup result and the repository after it, against $R/C601-pre.txt. No login. Dialog: none."
  { [[ -s $R/C601-pre.txt ]] || { print "STOP: no $R/C601-pre.txt: run C601 first"; exit 1; }
    [[ -s $R/C601.txt ]] || { print "STOP: no $R/C601.txt: Main has not saved the raw cleanup result yet (C601's prompt)"; exit 1; }
    pre() { sed -n "s/^PRE $1 //p" $R/C601-pre.txt | head -1; }
    ptip=$(pre tip) pwt=$(pre worktree) pbr=$(pre branch) pst=$(pre status) pdisp=$(pre disposition)
    raw=$(<$R/C601.txt); print -r -- "raw result (first 600 chars): ${raw[1,600]}"
    [[ $raw =~ '"cleanup_status" *: *"cleaned"' ]]; ck $? "C601r raw result cleanup_status cleaned"
    [[ $raw =~ '"task_disposition" *: *"cancelled"' ]]; ck $? "C601r evidence task_disposition cancelled"
    rtc=$(print -r -- $raw | grep -oE '"task_commit" *: *"[0-9a-f]{40}"' | head -1 | grep -oE '[0-9a-f]{40}')
    [[ -n $ptip && $rtc == $ptip ]]; ck $? "C601r task_commit == the pre-recorded tip" "result ${rtc:-none}, pre ${ptip:-none}"
    inlist=$(gg -C $REPO worktree list --porcelain | grep -cxF "worktree $pwt")
    [[ ! -e $pwt && $inlist == 0 ]]; ck $? "C601r 601's Worktree path is gone and not in git worktree list" "$([[ -e $pwt ]] && print 'path exists') listed $inlist"
    ! gg -C $REPO show-ref --verify --quiet refs/heads/$pbr; ck $? "C601r branch $pbr is gone"
    D=$(t601); miss=""
    for f in ${(f)"$(sed -n 's/^PRE file //p' $R/C601-pre.txt)"}; do [[ -e $D/$f ]] || miss="$miss $f"; done
    print -r -- "pre-recorded record files: $(grep -c '^PRE file ' $R/C601-pre.txt) | missing now:${miss:- none}"
    [[ -z $miss ]]; ck $? "C601r every pre-recorded record file of 601 is still present"
    st=$(yml $D/task.yml status) disp=$(disposition_of $D)
    [[ $st == $pst && $disp == $pdisp ]]; ck $? "C601r 601's status and disposition unchanged" "status $st, disposition $disp"
    dev=$(gg -C $REPO rev-parse -q --verify refs/heads/dev)
    [[ $dev == $DEVWANT && $dev == $(pre dev) ]]; ck $? "C601r dev unchanged (${DEVWANT[1,8]})" "${dev:-none}"
  } 2>&1 | tee $R/C601r.txt; rc=${pipestatus[1]}
  (( rc == 0 )) && ! grep -q ': FAIL' $R/C601r.txt || { print "\nC601r STOP or FAIL (see above). Hand $R/C601r.txt and $R/C601.txt to the Team."; exit 1; }
  summary C601r "$(grep -E '^CHECK' $R/C601r.txt)"
  print "Success: every 'CHECK 604 C601r ...: PASS'."
  next "zsh $THIS done" ;;

R) need_main; print "[R] USER (Main asks the USER first; after agreeing the USER /exits Main and runs this in a normal Terminal). Restores the whole venv (graphtraj ${OLD[1,8]} + graftling $GLVERSION), the hook copy and the entry files from $BK; the current ones are kept in $BK/after-install-*. No login. Dialog: none (one Enter). Enter to continue, Ctrl-C to stop."; read -r answer
  [[ -e $BK/COMPLETE ]] || { print "STOP: no complete backup in $BK (the install starts only after it): production was not changed by I. Tell Main."; exit 1; }
  { members_idle R || { print "STOP: a member or host runs (above). Nothing restored."; exit 1; }
    KEEP=$BK/after-install-$(date +%Y%m%dT%H%M%S); mkdir -p $KEEP/entries
    mv $RT $KEEP/venv && cp -Rp $BK/venv $RT || exit 1
    tree compare $BK/venv.manifest $RT; ck $? "R venv equals the pre-install bytes"
    [[ -e $PDIR ]] && mv $PDIR $KEEP/plugin; cp -Rp $BK/plugin $PDIR || exit 1
    tree compare $BK/plugin.manifest $PDIR; ck $? "R hook copy restored"
    for f in $ENTRIES; do cmp -s $f $BK/entries/${${f#$H/}//\//__} || { cp -p $f $KEEP/entries/ 2>/dev/null; cp -p $BK/entries/${${f#$H/}//\//__} $f; }; done
    shasum -a 256 -c $BK/entries.sha256; ck $? "R entry files restored"
    sp=$(site); dgt=$(cat $sp/graphtraj-$GTVERSION.dist-info/direct_url.json 2>/dev/null) dgl=$(cat $sp/graftling-$GLVERSION.dist-info/direct_url.json 2>/dev/null)
    [[ $dgt == *"wheels-${OLD[1,8]}/graphtraj-$GTVERSION-"* && $dgl == *"wheels-$GLVERSION/graftling-$GLVERSION-"* ]]; ck $? "R graphtraj from wheels-${OLD[1,8]} and graftling $GLVERSION from 600's wheel again"
    pc=$(clean $RT/bin/python -m pip check --disable-pip-version-check 2>&1); ck $? "R pip check" "${pc[1,120]}"
    CH=$H/.graphtraj/claude-host/live/channel.json; [[ -e $CH ]] && mv $CH $KEEP/channel.json && print "moved out a stale $CH"
  } 2>&1 | tee -a $R/R.txt
  grep -q '^CHECK 604 R .*: FAIL' $R/R.txt && { print "\nR left a difference (above). Do not resume Main; hand $R/R.txt to Main. R can be rerun."; exit 1; }
  print "Success: every 'CHECK 604 R ...: PASS'. Then (USER): cd $H && claude --continue" ;;

done) print "[done] Main. Read only: every CHECK line of every step's raw file, and production now. No login. Dialog: none."
  { miss=""
    steps=(00 S B V Mpre I Mr Nr C601-pre C601r)
    for s in $steps; do [[ -s $R/$s.txt ]] || miss="$miss $s"; done
    grep -h '^CHECK ' $R/${^steps}.txt(N)
    np=$(cat $R/${^steps}.txt(N) | grep -c '^CHECK .*: PASS') nf=$(cat $R/${^steps}.txt(N) | grep -cE '^CHECK .*: (FAIL|PENDING|NOT OBSERVED|CHECK BY HAND)')
    say "production now"
    sp=$(site); print -r -- "graphtraj graftling: $(clean $RT/bin/python -I -c 'import importlib.metadata as m; print(m.version("graphtraj"), m.version("graftling"))' 2>&1)"
    dgt=$(cat $sp/graphtraj-$GTVERSION.dist-info/direct_url.json 2>/dev/null) dgl=$(cat $sp/graftling-$GLVERSION.dist-info/direct_url.json 2>/dev/null)
    print -r -- "graphtraj direct_url: ${dgt:-none}"; print -r -- "graftling direct_url: ${dgl:-none}"
    [[ $dgt == *"$N/graphtraj-$GTVERSION-"* && $dgl == *"$W600/graftling-$GLVERSION-"* ]]
    ck $? "done production graphtraj from wheels-${TARGET[1,8]}, graftling $GLVERSION from 600's wheel"
    print -r -- "steps without a raw file:${miss:- none} | CHECK PASS $np | CHECK not passed $nf"
    [[ -z $miss && $nf == 0 ]]; ck $? "done every step ran and every CHECK passed"
  } 2>&1 | tee $R/done.txt
  grep -q '^CHECK 604 done every step ran and every CHECK passed: PASS' $R/done.txt && ! grep -qE '^CHECK .*: FAIL' $R/done.txt || { print "\ndone: FAIL (see above). Hand $R/done.txt to the Team."; exit 1; }
  print "Success: both 'CHECK 604 done ...: PASS' (production graphtraj ${TARGET[1,8]} wheel, graftling $GLVERSION unchanged; every step's CHECK passed)."
  next "Main: hand $R to the Team; Task 604 steps complete. Rollback stays available (Main asks the USER first): zsh $BK/tools/steps.zsh R" ;;

*) print "usage: zsh $THIS 00|S|B|V|Mpre|I|M|Mr|N|Nr|C601|C601r|done|R"; exit 2 ;;
esac
