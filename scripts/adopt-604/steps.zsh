#!/bin/zsh
[ -n "$ZSH_VERSION" ] || exec /bin/zsh "$0" "$@"
# Task 604 Main-run steps: production adoption of GraphTraj dev 1fdbbca5 (603: a cancelled Task's budget timer stops
# notifying; cleanup removes a cancelled, never-integrated Task's Worktree and branch and keeps its records). graftling
# stays 0.9.1 (600's wheel) and is never reinstalled. User's adoption decision: Worldline user-decision
# 20261124T182515.237335+0900. Claude login pre-approved for 00's probe and N: 20261124T182814.218485+0900.
# Run one step at a time:  zsh <this file> <STEP>     ONE ordered list:
#   00 -> S -> B -> V -> Mpre -> [Main tells the USER; 604's Leader and Engineer have ended their turns] USER /exit Main
#   -> I (USER, Terminal) -> USER `cd <Harness> && claude --continue` -> M -> Mr -> N -> Nr -> C601 -> C601r -> done.
#   Rollback: R (Main asks the USER first; the USER /exits Main).
#   00    Main. Read only (creates <Harness>/tmp/604). Login: one claude -p probe (pre-approved). Dialog: none.
#   S     Main. Read only: 603's full suite on this exact commit with the same 0.9.1 wheel replaces G/GR/SR/suite-base.
#   B     Main. git archive 1fdbbca5 -> tmp/604/gsrc; graphtraj wheel (Miniconda python3.13, offline) -> adoption/wheels-1fdbbca5.
#   V     Main. Scratch venv only; the hook copy regenerated by the product must be byte-identical to production's.
#   Mpre  Main. S and V passed; no member runs; Main tells the USER to /exit and run I.
#   I     USER in a Terminal. Backup tmp/604/backup, then pip install --force-reinstall --no-deps --no-index of the
#         graphtraj wheel ONLY; checks.
#   M, Mr, N, Nr  Main (resumed): real MCP calls, one real member dispatch and child creation (as 600).
#   C601, C601r   Main: 601's pre-state, ONE prompt for Main's public cleanup call (the step never calls cleanup), then
#         the read-only check of Main's raw result and of the repository.
#   done  Main. Read only. R: USER, restore 6fe8c8d9 + 0.9.1 from tmp/604/backup.
# Credentials: every started process gets an ALLOWLIST environment (clean(): HOME USER PATH TERM TMPDIR LANG and the
# step's own VAR=value); cred_guard STOPs if any *_API_KEY, *_TOKEN, *_BASE_URL or *_AUTH* name is in it (names only).
# Rehearsal only (Engineer; Main leaves all of these unset): ADOPT604_H, ADOPT604_WT, ADOPT604_STUB, ADOPT604_PROJECTS,
# ADOPT604_VPROJECT, ADOPT604_OUT, ADOPT604_SCRATCH, ADOPT604_S603 (a fixture copy of 603's realhost record),
# ADOPT604_REPO and ADOPT604_DEV (the scratch project holding the rehearsal's cancelled Task and its dev),
# ADOPT604_CLEAN_EXTRA (the sandbox's proxy variables for clean()).
# No zsh special parameter name is used as a variable (path is used only as zsh's PATH array, as 593 and 600).
emulate -L zsh
setopt pipe_fail no_unset no_bg_nice
TASKDIR=604-graphtraj-603-production-adoption
TASK_ID=604
H=${ADOPT604_H:-/Users/luoxiao/workspace/you-are-a-product-architect-delivery}   # the Harness (production)
WT=${ADOPT604_WT:-$H/.graphtraj/core/worktrees/$TASKDIR}                           # this Task Worktree
THIS=${0:A}
SD=${0:A:h}
S593=$WT/scripts/adopt-593                          # reused by path: adopt_tree.py, pkgdiff532.py, onegraft.py, ...
STEP=${1:-}
DECISION=20261124T182515.237335+0900                # the user's adoption decision
LOGIN_DECISION=20261124T182814.218485+0900          # the USER pre-approved their Claude login for 604's 00 probe and N
path=($HOME/.local/bin /opt/homebrew/bin $path)     # claude and node, as 593/600 (the USER's usual installs)
[[ -n ${ADOPT604_STUB:-} ]] && path=($ADOPT604_STUB $path)   # rehearsal only: stub claude/ps first
CONDA=/Users/luoxiao/miniconda3/bin/python3.13      # read only; builds the wheel, runs the helpers with -I
TARGET=1fdbbca5a95e68c098cb8e19c3d1159e40e96930     # the adoption commit = GraphTraj dev after 603's integration
OLD=6fe8c8d97b5eedaf3fae898cd3f3f86a66a7acf7        # production graphtraj now (593's wheel)
GLCOMMIT=e8c2e80241dff1151f2122e8957fca5598ec987b   # graftling 0.9.1 (600), stays installed
GLVERSION=0.9.1
GTVERSION=0.1.0
GUARDED=(src tests plugins manuals pyproject.toml)
STATE=$H/.graphtraj/core/state
T593=593-graftling-0-9-0-release-and-production-adoption
T600=600-graftling-0-9-1-release
T601=601-graftling-changelog-intro-stale
W593=$STATE/tasks/$T593/adoption/wheels-${OLD[1,8]}   # production's graphtraj wheel now (R's target)
W600=$STATE/tasks/$T600/adoption/wheels-$GLVERSION    # production's graftling wheel (unchanged)
AD=$STATE/tasks/$TASKDIR/adoption
N=$AD/wheels-${TARGET[1,8]}                         # the graphtraj wheel I installs (B writes it)
S603=${ADOPT604_S603:-$STATE/tasks/603-cancelled-task-timer-and-cleanup/realhost}   # 603's accepted suite record
SUITE603=$S603/suite-suite-${TARGET[1,8]}-20261124T185824.txt
D516=$STATE/tasks/516-low-priority-flaky-tests      # known flaky tests: 516's CURRENT definition via its task.yml
SCR=${ADOPT604_SCRATCH:-$H/tmp/604}
GSRC=$SCR/gsrc                                      # git archive $TARGET
WHL=$SCR/wheel
BK=$SCR/backup
BK600=$H/tmp/600/backup                             # the older rollback (600); only read
VV=$SCR/vvenv
R=${ADOPT604_OUT:-$STATE/tasks/$TASKDIR/realhost/main-raw}
RT=$H/.venv-runtime
VPROJ=${ADOPT604_VPROJECT:-/private/tmp/vproject-604}   # isolated project for the real MCP entries (graphtraj setup)
PDIR=$H/.claude/skills/graphtraj-claude-host
HOSTCFG=$H/.graphtraj/claude-host/config.json
ENTRIES=($H/.mcp.json $H/.claude/settings.local.json $HOSTCFG)
SESS=$H/.graphtraj/swarm/sessions
PROJECTS=${ADOPT604_PROJECTS:-$HOME/.claude/projects/${H//\//-}}
MODEL=claude-opus-5-5
CHILD=n604
DONEWORD=DONE-604
MAIN=$(cat $SCR/main.session 2>/dev/null)
REPO=${ADOPT604_REPO:-$WT}                          # the GraphTraj repository holding dev and Task 601's Worktree
DEVWANT=${ADOPT604_DEV:-$TARGET}                    # dev before and after 601's cleanup (rehearsal: the scratch project's)

next() { print -- "\n==> next (paste as is): $*"; }
say()  { print -- "\n### $*"; }
summary() { print -- "\n----- summary for Main ($1) -----"; shift; print -l -- "$@"; print -- "-----"; }
clean() { env -i HOME=$HOME USER=${USER:-luoxiao} PATH=${(j.:.)path} TERM=${TERM:-xterm} TMPDIR=${TMPDIR:-/tmp} LANG=${LANG:-en_US.UTF-8} ${=ADOPT604_CLEAN_EXTRA:-} "$@"; }
cred_guard() {
  local names; names=$(clean env | cut -d= -f1 | grep -E '_API_KEY$|_TOKEN$|_BASE_URL$|_AUTH' | tr '\n' ' ')
  [[ -z $names ]] || { print -r -- "STOP: credential-like names in the clean environment: $names"; exit 97; }
}
gg() { clean git "$@"; }                            # every git call: allowlist environment
ck() { [[ $1 == 0 ]] && print -r -- "CHECK 604 $2: PASS${3:+ ($3)}" || print -r -- "CHECK 604 $2: FAIL${3:+ ($3)}"; }   # $1 = 0 for pass
helper() { [[ -f $SD/$1 ]] && print -r -- $SD/$1 || print -r -- $S593/$1; }   # R runs from $BK/tools with its own copies
tree() { clean $CONDA -I $(helper adopt_tree.py) "$@"; }
site() { local s=($RT/lib/python*/site-packages(N)); print -r -- ${s[1]:-$RT/lib/python3.13/site-packages}; }
claude_bin() { command -v claude || print -r -- $HOME/.local/bin/claude; }
cv() { local C=$(claude_bin); print -r -- "claude: $C -> ${C:A} | version: $(clean $C --version 2>&1 | head -1) | recorded at 00: $(cat $SCR/cc.version 2>/dev/null || print none)"; }
need_main() { [[ -n $MAIN ]] || { print "STOP: no $SCR/main.session (Main's Session id): run 00 first"; exit 1; }; }
yml() { local f=$1 k=$2; print -r -- ${${${(M)${(f)"$(cat $f 2>/dev/null)"}:#${k}: *}#${k}: }//[\'\"]/}; }   # one top-level scalar
cdef_of() { local d=$1 c; c=$(yml $d/task.yml current_definition); print -r -- ${c:+$d/$c}; }   # current definition file
disposition_of() { local f; f=$(cdef_of $1); [[ -n $f ]] && sed -n 's/^  disposition: *//p' $f | head -1 | tr -d "'\""; }
KNOWN516=$(cdef_of $D516)
check_tmp() {
  case ${${TMPDIR:-/tmp}:A}/ in ${H:A}/*) print "STOP: TMPDIR ${TMPDIR:-/tmp} is inside the Harness"; return 1 ;; esac
  print -r -- "TMPDIR=${TMPDIR:-/tmp} (outside the Harness)"
}
product_guard() {  # dev = TARGET; HEAD contains TARGET and differs from it only under scripts/adopt-604; guarded paths clean
  local dev head names other dirty
  dev=$(gg -C $WT rev-parse -q --verify refs/heads/dev) head=$(gg -C $WT rev-parse HEAD)
  names=$(gg -C $WT diff --name-only $TARGET HEAD -- $GUARDED 2>&1); other=$(gg -C $WT diff --name-only $TARGET HEAD 2>&1 | grep -v '^scripts/adopt-604/')
  dirty=$(gg -C $WT status --porcelain -- . ':!scripts/adopt-604/rehearsal' 2>&1)
  print -r -- "product guard: dev ${dev:-none} | HEAD $head | git diff ${TARGET[1,8]} HEAD -- ${GUARDED[*]}: ${${names//$'\n'/ }:-empty} | other changes since ${TARGET[1,8]} outside scripts/adopt-604: ${${other//$'\n'/ }:-none} | uncommitted (rehearsal outputs excepted): ${${dirty//$'\n'/ }:-none}"
  [[ $dev == $TARGET ]] && gg -C $WT merge-base --is-ancestor $TARGET HEAD && [[ -z $names && -z $other && -z $dirty ]]
}
detect_main() {  # the Claude Main: parent of the host serving $HOSTCFG (argv --resume/--session-id), else the newest transcript
  local hit words pp cmd id="" t
  hit=$(ps -axww -o pid=,ppid=,command= 2>/dev/null | grep -F -- "$HOSTCFG" | grep -F -- ' serve ' | head -1)
  words=(${=hit}); pp=${words[2]:-}
  if [[ -n $pp ]]; then
    cmd=$(ps -ww -o command= -p $pp 2>/dev/null); print -r -- "host pid ${words[1]}, parent $pp: ${cmd[1,160]}" >&2
    id=$(print -r -- "$cmd" | grep -oE -- '--(resume|session-id)[ =][0-9a-f-]{36}' | grep -oE '[0-9a-f-]{36}$' | head -1)
  else print -r -- "no host serving $HOSTCFG found by ps" >&2; fi
  if [[ -z $id ]]; then t=($PROJECTS/*.jsonl(N.om[1])); [[ -n ${t[1]:-} ]] && { id=${t[1]:t:r}; print -r -- "source: newest transcript ${t[1]:t}" >&2; }; fi
  print -r -- $id
}
# 593/600's guard: BLOCKING = a live process naming $RT/, Main's host config or Main's Session id; budget timers and
# zombies are listed, never blocking; nothing is ever signalled. Return 2 when ps cannot list.
guard() {
  local listing line words hits=() timers=() zombies=0
  listing=$(ps -axww -o pid=,stat=,etime=,command= 2>&1) || { print "guard: ps cannot list processes; run this step in a normal Terminal"; return 2; }
  for line in ${(f)listing}; do
    words=(${=line}); [[ ${words[1]} == $$ ]] && continue
    [[ ${words[2]} == *Z* ]] && { zombies=$(( zombies + 1 )); continue; }
    [[ $line == *"-m graphtraj.execution.budget_idle_timer"* ]] && { timers+=("${line[1,200]}"); continue; }
    [[ $line == *"$RT/"* || $line == *"$HOSTCFG"* || ( -n $MAIN && $line == *"$MAIN"* ) ]] && hits+=("${line[1,200]}")
  done
  print "guard: budget_idle_timer processes (NON-BLOCKING, never signalled): ${#timers}"; (( ${#timers} )) && print -l -- "  "$timers
  print "guard: zombies (information): $zombies"
  (( ${#hits} == 0 )) && { print "guard: BLOCKING 0 (no process uses $RT)"; return 0; }
  print "guard: BLOCKING ${#hits} (processes using $RT or Main ${MAIN:-?}; wait for them, never kill):"; print -l -- "  "$hits
  return 1
}
members_idle() {  # $1 = phase. STOP while a member Worker or swarm batch runs; after Mpre also guard's BLOCKING 0
  local listing; listing=$(ps -axww -o pid=,etime=,command= 2>&1) || { print "STOP: ps cannot list processes"; return 2; }
  local -a workers=(${${(f)"$(print -r -- $listing | grep -E -- '-m graphtraj\.execution\.runner_worker|-m graphtraj\.teams\.team_round' | grep -v -- 'grep -E')"}:#})
  print -r -- "members_idle [$1]: Task $TASK_ID's Leader and Engineer must have ended their turns; member Workers and swarm batches running now: ${#workers}"
  (( ${#workers} )) && { print -l -- "  "${^workers[1,12]}; return 1; }
  if [[ $1 != Mpre && $1 != 00 ]]; then guard || return 1; fi
  print -r -- "members_idle [$1]: no member execution is active: PASS"
}
vproject_init() {  # $1 = graphtraj command: an isolated project with its own git and .graphtraj (setup), never the Harness
  mkdir -p $VPROJ
  [[ -d $VPROJ/.git ]] || gg -C $VPROJ init -q --initial-branch=main || return 1
  if ! gg -C $VPROJ rev-parse -q --verify HEAD > /dev/null; then
    print -r -- "# 604 scratch project" > $VPROJ/README.md
    gg -C $VPROJ add README.md && gg -C $VPROJ -c user.name=604 -c user.email=604@invalid commit -qm "Initial source" || return 1
  fi
  if ! { [[ -e $VPROJ/.graphtraj/core/config.yml || -e $VPROJ/.graphtraj/config.yml ]] && gg -C $VPROJ rev-parse -q --verify refs/heads/dev > /dev/null; }; then
    (cd $VPROJ && print -r -- y | clean $1 setup) > /dev/null || return 1
  fi
}
mcp_probe() {  # $1 = label, $2 = venv: graphtraj-mcp tools/list exactly subagents, tasks and 'agents' unknown (593's mcp593.py)
  (cd ${TMPDIR:-/tmp} && clean $2/bin/python -I $(helper mcp593.py) $1 $VPROJ $2/bin/graphtraj-mcp); ck $? "$1 graphtraj-mcp tools/list is exactly subagents, tasks and 'agents' is unknown (mcp593.py above)"
}
codex_hook_check() {  # $1 = venv: the Codex hooks entry names this venv's python and answers a neutral event with {} (no login)
  local P=$1/bin/python out cmd
  out=$(cd $VPROJ && clean $P -I -m graphtraj.runtimes.codex.stop_hook --configuration 2>&1)
  cmd=$(print -r -- "$out" | clean $CONDA -I -c 'import json,sys; d=json.load(sys.stdin); print(sorted({h["command"] for e in d["hooks"].values() for g in e for h in g["hooks"]}), sorted(d["hooks"]))' 2>&1)
  print -r -- "Codex hooks entry configuration: $cmd"
  [[ $cmd == *"'$P -m graphtraj.runtimes.codex.stop_hook'"*"'SessionEnd', 'SessionStart', 'Stop'"* ]]; ck $? "Codex hooks entry of $1 names its python for SessionStart/Stop/SessionEnd"
  out=$(print -r -- '{"hook_event_name":"Probe604","session_id":"probe-604","cwd":"'$VPROJ'"}' | (cd $VPROJ && clean $P -I -m graphtraj.runtimes.codex.stop_hook) 2>&1)
  [[ $out == '{}' ]]; ck $? "Codex hooks entry of $1 runs (neutral event answers {})" "${out[1,200]}"
}
manuals_check() {  # $1 = label, $2 = directory holding the installed manuals tree (share/graphtraj/manuals): == the archive's
  local d; d=$(diff -r $GSRC/manuals $2 2>&1); print -r -- "diff -r archive manuals vs $2: ${${d//$'\n'/ | }[1,300]:-none}"
  [[ -z $d ]]; ck $? "$1 share/graphtraj/manuals equals git archive ${TARGET[1,8]}'s manuals ($(find $2 -type f 2>/dev/null | wc -l | tr -d ' ') files)"
}
t601() { print -r -- $STATE/tasks/$T601; }
nr_read() {  # 593's nr_read (its Python, read from adopt-593/steps.zsh and run as is, with the child's done word DONE-604)
  clean $CONDA -I -c 'import sys
src = open(sys.argv[1]).read()
body = src.split("<<" + chr(39) + "PY2" + chr(39) + "\n", 1)[1].split("\nPY2\n", 1)[0].replace("DONE-593", sys.argv[2])
sys.argv = ["nr_read"] + sys.argv[3:]
exec(compile(body, "adopt-593 nr_read", "exec"))' $S593/steps.zsh $DONEWORD $H $SESS $TASKDIR $R $CHILD
}

mkdir -p $R || exit 1
cred_guard
case $STEP in
00) print "[00] Main. Read only, apart from creating $SCR (main.session, cc.version). Login: yes, one claude -p probe with the USER's Claude login, pre-approved (Worldline user-decision $LOGIN_DECISION); no Codex, Pi or DSH. No network besides Claude. Dialog: none."
  { mkdir -p $SCR || exit 1
    ck $([[ -n ${ZSH_VERSION:-} ]]; print $?) "00 runs under zsh" "zsh $ZSH_VERSION"
    check_tmp; ck $? "00 TMPDIR outside the Harness"
    say "production $RT (read only)"
    pv=$(clean $RT/bin/python -I -c 'import importlib.metadata as m; print(m.version("graphtraj"), m.version("graftling"))' 2>&1); print -r -- "production graphtraj graftling: $pv"
    sp=$(site); dgt=$(cat $sp/graphtraj-$GTVERSION.dist-info/direct_url.json 2>/dev/null) dgl=$(cat $sp/graftling-$GLVERSION.dist-info/direct_url.json 2>/dev/null)
    print -r -- "graphtraj direct_url: ${dgt:-none}"; print -r -- "graftling direct_url: ${dgl:-none}"
    [[ $pv == "$GTVERSION $GLVERSION" && $dgt == *"$W593/graphtraj-$GTVERSION-"*.whl* && $dgl == *"$W600/graftling-$GLVERSION-"*.whl* ]]
    ck $? "00 production is graphtraj $GTVERSION (593's wheels-${OLD[1,8]}) + graftling $GLVERSION (600's wheels-$GLVERSION)"
    pc=$(clean $RT/bin/python -m pip check --disable-pip-version-check 2>&1); ck $? "00 production pip check" "${pc[1,120]}"
    print -r -- "production bin: $(print -l $RT/bin/{agents,agents-mcp,subagents,subagents-mcp,graphtraj-mcp,agent-runner}(N:t) | tr '\n' ' ')"
    [[ -x $RT/bin/subagents && -x $RT/bin/subagents-mcp && ! -e $RT/bin/agents ]]; ck $? "00 production bin has subagents, subagents-mcp (and no agents)"
    say "this Worktree $WT and GraphTraj dev"
    product_guard; ck $? "00 GraphTraj dev = ${TARGET[1,8]}; this Worktree's HEAD contains it, its product (${GUARDED[*]}) equals it, and it is clean"
    print -r -- "git diff --name-only ${OLD[1,8]} ${TARGET[1,8]} (information; 603's changes): $(gg -C $WT diff --name-only $OLD $TARGET -- $GUARDED | tr '\n' ' ')"
    say "backups"
    [[ ! -e $BK ]]; ck $? "00 backup $BK absent"
    print -r -- "600's backup $BK600 (the older rollback, information): $([[ -e $BK600/COMPLETE ]] && print COMPLETE || print 'not complete or absent')"
    say "Task $TASK_ID"
    cdef=$(cdef_of $STATE/tasks/$TASKDIR)
    [[ -n $cdef && -f $cdef ]]; ck $? "00 probe Task $TASK_ID ready (current_definition ${cdef:t} exists)"
    say "Task 601 (read only; C601 cleans it)"
    D=$(t601); st=$(yml $D/task.yml status) disp=$(disposition_of $D) w601=$(yml $D/task.yml worktree) b601=$(yml $D/task.yml branch)
    print -r -- "601 (current definition $(cdef_of $D | xargs basename 2>/dev/null)): status ${st:-unreadable} | disposition ${disp:-unreadable} | worktree ${w601:-none} | branch ${b601:-none}"
    [[ $disp == cancelled && -n $st && $st != integrated ]]; ck $? "00 601 is cancelled and was never integrated"
    reg=$(gg -C $REPO worktree list --porcelain | awk -v w="worktree $H/$w601" '$0==w{f=1; next} /^worktree /{f=0} f && /^branch /{print substr($0,8)}')
    tip=$(gg -C $REPO rev-parse -q --verify refs/heads/$b601)
    print -r -- "601 worktree $H/$w601: $([[ -d $H/$w601 ]] && print exists || print MISSING) | registered on: ${reg:-not registered} | branch tip: ${tip:-none}"
    [[ -d $H/$w601 && $reg == refs/heads/$b601 && -n $tip ]]; ck $? "00 601's registered Worktree exists on its branch, branch tip ${tip[1,8]}"
    if s601=$(gg -C $H/$w601 status --porcelain --untracked-files=all 2>&1); then
      [[ -z $s601 ]]; ck $? "00 601's Worktree is clean" "${${s601//$'\n'/ }[1,200]}"
    else print -r -- "INFO 604 00 601's Worktree status not readable here: ${s601[1,200]} (C601 records it again)"; fi
    say "Claude: version and one claude -p probe (the USER pre-approved their Claude login for Task 604: Worldline user-decision $LOGIN_DECISION)"
    C=$(claude_bin); [[ -s $SCR/cc.version ]] || clean $C --version 2>&1 | head -1 > $SCR/cc.version; cv
    P=$(mktemp -d ${TMPDIR:-/tmp}/probe-604.XXXXXX)
    ans=$(cd $P && print -r -- "Reply with one line: READY-604, your model id, and LOGGED-IN if you answer through a login." | clean /usr/bin/perl -e 'alarm shift; exec @ARGV' 120 $C -p --model $MODEL 2>&1 | head -3)
    print -r -- "claude answered: $ans"; [[ $ans == *READY-604* ]]; ck $? "00 claude -p answers READY-604 (model and login above)"
    say "Main's Session (I, M, Mr need it)"
    id=$(detect_main); [[ -n $id ]] && print -r -- $id > $SCR/main.session
    print -r -- "MAIN=${id:-NOT FOUND} (saved to $SCR/main.session)"; [[ -n $id ]]; ck $? "00 Main's Session id found"
    print -r -- "plugin and entry files (hashes; V and I require them unchanged):"; shasum -a 256 $PDIR/hooks/host_context.mjs $PDIR/hooks/hooks.json $PDIR/.claude-plugin/plugin.json $ENTRIES 2>&1 | sed 's/^/  /'
    members_idle 00 | head -14 || print "(information at 00: members may run now; Mpre and I wait for them)"
  } 2>&1 | tee $R/00.txt
  grep -q ': FAIL' $R/00.txt && { print "\n00 STOP: a CHECK failed (see above). Nothing was changed. Hand $R/00.txt to the Team."; exit 1; }
  summary 00 "$(grep -E '^(CHECK|INFO|TMPDIR|production|601|claude|MAIN=|members_idle)' $R/00.txt)"
  print "Success: every 'CHECK 604 00 ...: PASS'."
  next "zsh $THIS S" ;;

S) print "[S] Main. Read only. Replaces G/GR/SR/suite-base: 603's full suite ran on this exact commit ${TARGET[1,8]} with the same graftling 0.9.1 wheel ($GLCOMMIT); its record is read and every FAILED/ERROR id is classed against 516's CURRENT definition. No login. Dialog: none."
  { rm -f $R/S.ok
    print -r -- "603 record: $S603"; print -r -- "  run.txt: $(cat $S603/run.txt 2>/dev/null | head -1)"
    [[ -f $S603/run.txt && -f $SUITE603 ]] || { print -r -- "STOP: no 603 record ($S603/run.txt, $SUITE603)"; exit 1; }
    line=$(head -1 $S603/run.txt)
    cand=$(print -r -- $line | grep -oE 'candidate GraphTraj [0-9a-f]{40}' | awk '{print $3}') glw=$(print -r -- $line | grep -oE 'graftling [0-9a-f]{40} \(wheel\)' | awk '{print $2}')
    troot=$(print -r -- $line | sed -n 's/^pytest temp root: \([^ ]*\) .*/\1/p')
    [[ $cand == $TARGET ]]; ck $? "S 603's suite candidate is ${TARGET[1,8]} (the adoption commit)" "${cand:-none}"
    w600c=$(cat $W600/GRAFTLING 2>/dev/null); print -r -- "600's wheel GRAFTLING file: ${w600c:-none}"
    [[ $glw == $GLCOMMIT && $w600c == *$GLCOMMIT* ]]; ck $? "S 603's suite graftling is the 0.9.1 wheel ($GLCOMMIT, = production's 600 wheel)" "${glw:-none}"
    tin=0; case ${troot:A}/ in ${H:A}/*|/) tin=1 ;; esac; [[ -n $troot && $line == *'outside the Harness'* ]] || tin=1
    ck $tin "S 603's pytest temp root is outside the Harness" "${troot:-none}"
    print -r -- "516 current definition (task.yml current_definition): ${KNOWN516:-none}"
    [[ -f $KNOWN516 ]]; ck $? "S 516's current definition is readable"
    tot=$(grep -E '^[0-9]+ (failed|passed|error)' $SUITE603 | tail -1) ex=$(sed -n 's/^exit=//p' $SUITE603 | tail -1)
