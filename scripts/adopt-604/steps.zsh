V) print "[V] Main. Before the install, outside production: a scratch venv ($VV) with the new graphtraj wheel + 600's graftling $GLVERSION wheel; the real MCP entry in an isolated project ($VPROJ); the hook copy regenerated by the product into a scratch copy must be byte-identical to production's. No login. Dialog: none. ~1 min."
  { rm -f $R/V.ok
    [[ -f $N/SHA256SUMS ]] && (cd $N && shasum -a 256 -c SHA256SUMS) && [[ $(<$N/COMMIT) == $TARGET ]] || { print "STOP: no checked wheel in $N: run B first"; exit 1; }
    product_guard; ck $? "V product guard"
