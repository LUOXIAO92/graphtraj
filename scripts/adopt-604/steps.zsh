    new=0 nids=0
    for id in ${(f)"$(sed -nE 's/^(FAILED|ERROR) ([^ ]+).*/\2/p' $SUITE603)"}; do
      nids=$(( nids + 1 )); t=${id%%\[*}
      if [[ -f $KNOWN516 ]] && grep -qF -- "${t##*::}" $KNOWN516; then print -r -- "  known (516): $id"; else print -r -- "  NEW: $id"; new=1; fi
    done
    print -r -- "FAILED/ERROR ids: $nids"
    (( new == 0 && nids == 2 )); ck $? "S every FAILED/ERROR id is named in 516's current definition"
    ab=$(grep -E '^ABNORMAL |timed out after' $SUITE603); print -r -- "ABNORMAL / timed-out shard lines: ${ab:-none}"
    [[ -z $ab ]]; ck $? "S no ABNORMAL or timed-out shard"
    nn=$(grep -c . $S603/new-ids.txt 2>/dev/null); print -r -- "603's new-ids.txt non-blank lines: ${nn:-file missing}"
    [[ -f $S603/new-ids.txt && $nn == 0 ]]; ck $? "S 603's new-ids.txt is empty"
  } 2>&1 | tee $R/S.txt; rc=${pipestatus[1]}
  (( rc == 0 )) && ! grep -q ': FAIL' $R/S.txt || { print "\nS STOP (see above). Nothing changed. Hand $R/S.txt to the Leader (a full suite would be needed)."; exit 1; }
  touch $R/S.ok
  summary S "$(grep -E '^(totals|CHECK|  NEW|  known)' $R/S.txt)"
  print "Success: every 'CHECK 604 S ...: PASS'."
  next "zsh $THIS B" ;;

B) print "[B] Main. git archive ${TARGET[1,8]} -> $GSRC; graphtraj wheel from the archive root with $CONDA (--no-index --no-deps --no-build-isolation) -> $N. No network, no login. Dialog: none."
  { rm -rf $GSRC $WHL $SCR/wheelview; mkdir -p $GSRC $WHL $SCR/wheelview || exit 1
    gg -C $WT archive $TARGET | tar -x -C $GSRC || exit 1
    print -r -- "git archive $TARGET -> $GSRC"
    sv=$(clean $CONDA -I -c 'import setuptools, pip; print("setuptools", setuptools.__version__, "| pip", pip.__version__)' 2>&1); ck $? "B setuptools importable offline in $CONDA" "$sv"
    (cd $SCR && clean $CONDA -m pip wheel -q --disable-pip-version-check --no-cache-dir --no-index --no-deps --no-build-isolation -w $WHL $GSRC) || { print "STOP: the wheel build failed"; exit 1; }
    whl=($WHL/graphtraj-$GTVERSION-*.whl(N)); all=($WHL/*.whl(N)); print -r -- "wheel: ${all[*]:t}"
    (( $#whl == 1 && $#all == 1 )) || { print "STOP: expected exactly one graphtraj-$GTVERSION wheel in $WHL"; exit 1; }
    whl=$whl[1]; old=($W593/graphtraj-$GTVERSION-*.whl(N))
    (cd $SCR/wheelview && unzip -qo $whl) || exit 1
    say "wheel == git archive ${TARGET[1,8]}, file by file (593's pkgdiff532.py)"
    clean $CONDA -I $S593/pkgdiff532.py graphtraj $whl archive:$GSRC/src "604 B graphtraj wheel equals git archive ${TARGET[1,8]}" -
    ck $? "B the wheel's graphtraj/ files equal git archive ${TARGET[1,8]}"
    say "data files share/graphtraj/manuals (pyproject data-files) and metadata vs 593's ${OLD[1,8]} wheel"
    clean $CONDA -I -c 'import sys, tomllib, zipfile
from pathlib import Path
whl, src, old = sys.argv[1], Path(sys.argv[2]), sys.argv[3]
spec = tomllib.load(open(src / "pyproject.toml", "rb"))["tool"]["setuptools"]["data-files"]
want = {f"{d}/{Path(f).name}": src / f for d, fs in spec.items() for f in fs}
z, zo = zipfile.ZipFile(whl), zipfile.ZipFile(old)
def data(zf):
    return {n.split(".data/data/", 1)[1]: n for n in zf.namelist() if ".data/data/" in n}
got, gold = data(z), data(zo)
bad = sorted(set(want) ^ set(got)) + sorted(k for k in set(want) & set(got) if z.read(got[k]) != want[k].read_bytes())
print(f"data files in the pyproject: {len(want)} | in the wheel: {len(got)} | differing or missing: {bad or 0}")
print("changed since 593 (information; 603 changes 3):", sorted(k for k in got if k not in gold or z.read(got[k]) != zo.read(gold[k])))
def meta(zf, name):
    return [n for n in zf.namelist() if n.endswith(".dist-info/" + name)][0]
ep = z.read(meta(z, "entry_points.txt")) == zo.read(meta(zo, "entry_points.txt"))
rq = lambda zf: sorted(l for l in zf.read(meta(zf, "METADATA")).decode().splitlines() if l.startswith("Requires-Dist:"))
print("Requires-Dist:", rq(z))
from packaging.requirements import Requirement
g = [Requirement(l.split(":", 1)[1].strip()) for l in rq(z) if l.split(":", 1)[1].strip().startswith("graftling")]
inc = len(g) == 1 and g[0].specifier.contains(sys.argv[4])
print(f"CHECK 604 B data files equal the archive manuals ({len(want)} files): {"PASS" if not bad and want else "FAIL"}")
print(f"CHECK 604 B entry_points.txt identical to 593 wheel: {"PASS" if ep else "FAIL"}")
print(f"CHECK 604 B Requires-Dist identical to 593 wheel: {"PASS" if rq(z) == rq(zo) else "FAIL"}")
print(f"CHECK 604 B graftling range includes {sys.argv[4]}: {"PASS" if inc else "FAIL"} ({g[0] if g else None})")
' $whl $GSRC ${old[1]:-$W593/missing.whl} $GLVERSION 2>&1 || ck 1 "B data files and metadata read"
    say "603 markers in the wheel"
    m1=$(grep -c 'state\["disposition"\] == "cancelled"' $SCR/wheelview/graphtraj/execution/runner_cleanup.py 2>/dev/null) m2=$(grep -c 'or one cancelled task' $SCR/wheelview/graphtraj/interfaces/tools.py 2>/dev/null)
    print -r -- "  runner_cleanup.py: disposition == cancelled x${m1:-0} | tools.py cleanup description 'or one cancelled task' x${m2:-0}"
    (( ${m1:-0} > 0 && ${m2:-0} > 0 )); ck $? "B 603's markers are in the wheel"
    leaked=$(unzip -Z1 $whl | grep -cE '(^|/)(build|__pycache__)/'); print -r -- "leaked build/ or __pycache__/ entries: $leaked"
    [[ $leaked == 0 ]]; ck $? "B no build/ or __pycache__ in the wheel"
    print -r -- "wheel sha256: $(shasum -a 256 $whl)"
    say "the wheel I installs: $N"
    rm -rf $N && mkdir -p $N && cp -p $whl $N/ && (cd $N && shasum -a 256 *.whl > SHA256SUMS) && print -r -- $TARGET > $N/COMMIT || exit 1
    (cd $N && shasum -a 256 -c SHA256SUMS) && [[ $(<$N/COMMIT) == $TARGET ]]; ck $? "B $N holds the wheel with SHA256SUMS and COMMIT ${TARGET[1,8]}"
  } 2>&1 | tee $R/B.txt; rc=${pipestatus[1]}
  (( rc == 0 )) && ! grep -q ': FAIL' $R/B.txt || { print "\nB STOP (see above). Nothing in production changed. Hand $R/B.txt to the Team."; exit 1; }
  summary B "$(grep -E '^(CHECK|wheel|data files|changed since)' $R/B.txt)"
  print "Success: every 'CHECK 604 B ...: PASS'."
