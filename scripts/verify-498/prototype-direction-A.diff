+def _exec_done(pid: int) -> bool:
+    """Whether ``pid`` has executed an image since its fork (darwin P_EXEC; Linux not PF_FORKNOEXEC)."""
+    try:
+        if sys.platform == 'darwin':
+            buffer = ctypes.create_string_buffer(136)
+            if _proc().proc_pidinfo(pid, 3, 0, buffer, 136) < 136:
+                return False
+            return bool(int.from_bytes(buffer.raw[0:4], sys.byteorder) & 0x4000)
+        stat = Path(f'/proc/{pid}/stat').read_text()
+        return not int(stat[stat.rindex(')') + 2:].split()[6]) & 0x40
+    except (OSError, ValueError, IndexError):
+        return False
+
+
+def _platform(pid: int) -> bool:
+    if sys.platform != 'darwin':
+        return False
+    value = ctypes.c_uint32(0)
+    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)
+    return libc.csops(pid, 0, ctypes.byref(value), 4) == 0 and bool(value.value & 0x4000000)
+
+
+def _verdict(pid: int, marker: str) -> str:
+    """'ours', 'foreign' (final), 'copy-ours' (fork copy, provisional), or 'later' (undecided, not cached)."""
+    view = _process_view(pid)
+    if not _exec_done(pid):
+        return 'later' if view is not None and view[1] and f'{MEMBER_RUN_ENV}={marker}' not in view[1] else 'copy-ours'
+    if view is None:
+        return 'later'
+    if not view[1]:
+        return 'ours' if _platform(pid) else 'later'
+    return 'ours' if f'{MEMBER_RUN_ENV}={marker}' in view[1] else 'foreign'
+
+
