#!/usr/bin/env python3
"""Rehearsal stand-in for dsh (Task 570): only what steps.zsh calls, so every step runs end to end.

plugin --profile P add SPEC     profile package.json with bundle graftling-dsh (and STUB570_PLUGIN's files)
plugin --profile P remove NAME  the bundle removed
--profile P --dump-config       one line naming agents-host while the bundle is there
--profile P PROMPT              a canned answer in the shape the prompts ask for; a create prompt writes one
                                completed agent record where the real host would
--version                       a version line
STUB570_INERT_WITHOUT_CONFIG=1: no agents tool without GRAFTLING_DSH_CONFIG (the base's behaviour).
STUB570_FAIL=1: the tool call fails with invalid-input and nothing is written.
"""
import json, os, re, shutil, sys, uuid
from pathlib import Path

args = sys.argv[1:]
home = Path(os.environ.get('DSH_HOME') or Path.home() / '.dsh')
if args == ['--version']:
    print('0.2.2-rc.5 (stub)'); sys.exit(0)
profile = args[args.index('--profile') + 1] if '--profile' in args else 'headless'
manifest = home / 'profiles' / profile / 'package.json'
if args[:1] == ['plugin']:
    manifest.parent.mkdir(parents=True, exist_ok=True)
    if 'add' in args:
        spec = args[-1]
        manifest.write_text(json.dumps({'dependencies': {'graftling-dsh': spec},
                                        'dsh': {'profile': {'bundles': ['graftling-dsh']}}}, indent=2))
        source = os.environ.get('STUB570_PLUGIN')
        if source:
            target = manifest.parent / 'node_modules' / 'graftling-dsh'
            shutil.copytree(source, target, symlinks=True, dirs_exist_ok=True)
        print(f'added {spec} (stub)')
    elif 'remove' in args:
        manifest.write_text(json.dumps({'dependencies': {}, 'dsh': {'profile': {'bundles': []}}}, indent=2))
        print('removed (stub)')
    sys.exit(0)
bundles = json.loads(manifest.read_text())['dsh']['profile']['bundles'] if manifest.is_file() else []
if '--dump-config' in args:
    print('  - id: agents-host  name: graftling-dsh' if 'graftling-dsh' in bundles else '  (no plugins)')
    sys.exit(0)
prompt = args[-1]
config = os.environ.get('GRAFTLING_DSH_CONFIG')
tool = 'graftling-dsh' in bundles and (config or not os.environ.get('STUB570_INERT_WITHOUT_CONFIG'))
if 'name of the model' in prompt:
    print('deepseek-flash (stub)'); sys.exit(0)
if not tool:
    print('TOOLS: NONE\nNO AGENTS TOOL'); sys.exit(0)
root = Path(json.loads(Path(config).read_text())['root']) if config else Path.cwd() / '.agents-control'
if os.environ.get('STUB570_DSH_REFUSE') and 'connections:' in ((root / 'config.yml').read_text() if (root / 'config.yml').is_file() else ''):
    print('dsh: {"error": {"code": "runtime-unavailable", "message": "Connection \'claude-haiku\': Claude Code is not logged in (stub)"}}')
    sys.exit(1)
(root / 'live' / 'dsh-host').mkdir(parents=True, exist_ok=True)
if os.environ.get('STUB570_FAIL'):
    print('TOOLS: mcp__graftling__agents\nERROR: {"error": {"code": "invalid-input", "message": "request.action: expected one of"}}')
    sys.exit(0)
if '"feature":"create"' not in prompt:
    print('TOOLS: mcp__graftling__agents\nRESULT: {"result": {"agents": []}}'); sys.exit(0)
word = re.search(r'one word: (\w+)', prompt).group(1)
import stubrecord
print(stubrecord.write(root, 'dsh', 'dsh-native', word))
