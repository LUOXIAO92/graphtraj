#!/usr/bin/env python3
"""Rehearsal stand-in for dsh (Task 570): only what steps.zsh calls, so every step runs end to end.

plugin --profile P add SPEC     profile package.json with bundle graftling-dsh (and STUB570_PLUGIN's files)
plugin --profile P remove NAME  the bundle removed
--profile P --dump-config       one line naming agents-host while the bundle is there
--profile P PROMPT              a canned answer; a create prompt writes one agent record where the real host would
--version                       a version line
"""
import json, os, shutil, sys, uuid
from pathlib import Path

args = sys.argv[1:]
home = Path(os.environ.get('DSH_HOME') or Path.home() / '.dsh')
if args == ['--version']:
    print('0.2.2-rc.5 (stub)'); sys.exit(0)
profile = args[args.index('--profile') + 1] if '--profile' in args else 'headless'
manifest = home / 'profiles' / profile / 'package.json'
if args[:1] == ['plugin']:
    manifest.parent.mkdir(parents=True, exist_ok=True)
    if 'add' in args:
        spec = args[-1]
        manifest.write_text(json.dumps({'dependencies': {'graftling-dsh': spec},
                                        'dsh': {'profile': {'bundles': ['graftling-dsh']}}}, indent=2))
        source = os.environ.get('STUB570_PLUGIN')
        if source:
            target = manifest.parent / 'node_modules' / 'graftling-dsh'
            shutil.copytree(source, target, symlinks=True, dirs_exist_ok=True)
        print(f'added {spec} (stub)')
    elif 'remove' in args:
        manifest.write_text(json.dumps({'dependencies': {}, 'dsh': {'profile': {'bundles': []}}}, indent=2))
        print('removed (stub)')
    sys.exit(0)
bundles = json.loads(manifest.read_text())['dsh']['profile']['bundles'] if manifest.is_file() else []
if '--dump-config' in args:
    print('  - id: agents-host  name: graftling-dsh' if 'graftling-dsh' in bundles else '  (no plugins)')
    sys.exit(0)
prompt = args[-1]
if 'graftling-dsh' not in bundles or 'Create one child' not in prompt:
    print('mcp__ tools: NONE\nNO AGENTS TOOL' if 'graftling-dsh' not in bundles else
          'deepseek-flash' if 'name of the model' in prompt else 'mcp__graftling__agents; status: no agents')
    sys.exit(0)
config = os.environ.get('GRAFTLING_DSH_CONFIG')
root = Path(json.loads(Path(config).read_text())['root']) if config else Path.cwd() / '.agents-control'
agent = f'agent-{uuid.uuid4().hex}'
(root / 'control' / 'agents').mkdir(parents=True, exist_ok=True)
(root / 'live' / 'dsh-host').mkdir(parents=True, exist_ok=True)
(root / 'control' / 'agents' / f'{agent}.json').write_text(json.dumps({
    'agent': agent, 'runtime': 'dsh', 'creator': {'host': 'dsh-native', 'session': 'session-stub'},
    'executions': [{'state': 'ended'}]}))
print(f'- Child agent id: {agent}\n- One-word answer: ready\n- Status: standby; delivered\nstatus lists: {agent}')
