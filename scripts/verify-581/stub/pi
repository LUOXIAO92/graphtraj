#!/usr/bin/env python3
"""Rehearsal stand-in for pi (Task 581): only what steps.zsh calls. It checks the script, not graftling.

--version; --list-models deepseek; install -l DIR (./.pi/settings.json names it); -p ... PROMPT: a one-line answer,
or for a create prompt one completed pi-native record in ./.agents-control.
"""
import json, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import stubrecord

args = sys.argv[1:]
if args == ['--version']:
    print('1.4.0 (stub)'); sys.exit(0)
if args[:1] == ['--list-models']:
    print('provider model\ndeepseek deepseek-v4-flash\ndeepseek deepseek-v4-pro'); sys.exit(0)
if args[:1] == ['install']:
    Path('.pi').mkdir(exist_ok=True)
    Path('.pi/settings.json').write_text(json.dumps({'packages': [args[-1]]}) + '\n')
    print('installed (stub)'); sys.exit(0)
settings = Path('.pi/settings.json')
packages = json.loads(settings.read_text()).get('packages') if settings.exists() else []
python = stubrecord.prefix_python(packages[0]) if packages else None
print(stubrecord.answer(args[-1], 'pi', python))
