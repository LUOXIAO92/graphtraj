#!/usr/bin/env python3
"""Rehearsal stand-in for ps (Task 581): the Engineer's sandbox cannot run /bin/ps. Main uses the real ps.

`ps -axww -o pid=,ppid=,command=`: the live rows the stubs registered in $STUB581_PSFILE
("pid<TAB>ppid<TAB>command<TAB>env names"); `ps -axwwE ...` appends each row's environment as NAME=x (the stubs
register names only, never values). Anything else: one line naming the stub.
"""
import os, sys

args = sys.argv[1:]
if args[1:] != ['-o', 'pid=,ppid=,command='] or args[0] not in ('-axww', '-axwwE'):
    print('zsh (ps stub)'); sys.exit(0)
path = os.environ.get('STUB581_PSFILE')
for line in open(path) if path and os.path.exists(path) else []:
    pid, ppid, command, names = line.rstrip('\n').split('\t')
    try:
        os.kill(int(pid), 0)
    except OSError:
        continue
    env = ' ' + ' '.join(f'{n}=x' for n in names.split()) if args[0] == '-axwwE' else ''
    print(f'{pid} {ppid} {command}{env}')
